<Window x:Class="mpm_GUI.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认操作"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFFFF" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Border x:Name="IconBadge" Width="36" Height="36" CornerRadius="8"
                    VerticalAlignment="Top" Margin="0,0,12,0">
                <TextBlock x:Name="IconGlyph" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="&#xE7BA;" TextOptions.TextFormattingMode="Ideal"/>
            </Border>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                           Foreground="#FF202124" TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageText" Margin="0,6,0,0" Foreground="#FF5F6368"
                           TextWrapping="Wrap" MaxWidth="360"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="取消" Width="84" Height="32" Margin="0,0,8,0"
                    Style="{StaticResource FlatButton}" Click="OnCancel"/>
            <Button x:Name="OkButton" Content="确定" Width="96" Height="32"
                    Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>
