// MinecraftPlayerManagement.exe 启动器图标与版本信息
#include "winres.h"

#define IDI_MC_APP 101

IDI_MC_APP ICON "..\\mc_icon.ico"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
#pragma code_page(936)

/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x5L
#else
 FILEFLAGS 0x4L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Qing_Xiaoyu_stlr"
            VALUE "FileDescription", "Minecraft 用户数据管理启动器"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "InternalName", "MinecraftPlayerManagement.exe"
            VALUE "LegalCopyright", "Copyright (C) 2025 晴小雨_stlr"
            VALUE "OriginalFilename", "MinecraftPlayerManagement.exe"
            VALUE "ProductName", "Minecraft 用户数据管理"
            VALUE "ProductVersion", "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
